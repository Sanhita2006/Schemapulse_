# ---- SchemaPulse configuration -------------------------------------------- #
# Copy to `.env` and edit. `.env` is git-ignored; never commit a real key.
# Every setting can also be supplied as an environment variable, which wins
# over this file.

# ---- Model provider -------------------------------------------------------- #
# gemini | ollama | fixture
#   fixture = deterministic, offline, no model call, always labelled as such.
SCHEMAPULSE_MODEL_PROVIDER=fixture

# Gemini (Google AI Studio). Read unprefixed as well as SCHEMAPULSE_-prefixed.
# GEMINI_API_KEY=your-key-here
# SCHEMAPULSE_GEMMA_MODEL=gemma-4-26b-a4b-it
# SCHEMAPULSE_GEMINI_BASE_URL=https://generativelanguage.googleapis.com/v1beta

# Ollama (local Gemma). Run `ollama serve` and `ollama pull gemma3:4b-it-q4_K_M`.
# OLLAMA_BASE_URL=http://localhost:11434
# OLLAMA_MODEL=gemma3:4b-it-q4_K_M
# SCHEMAPULSE_OLLAMA_TIMEOUT_S=180

# ---- Databases -------------------------------------------------------------- #
# SCHEMAPULSE_DATABASE_URL points at the database you want ANALYSED. It is only
# ever read with EXPLAIN on a SELECT.
# SCHEMAPULSE_SHADOW_DATABASE_URL is a DISPOSABLE copy where candidate indexes
# are created, measured, and dropped. The run aborts if these are identical.
SCHEMAPULSE_DATABASE_URL=postgresql://postgres:postgres@localhost:5432/schemapulse
SCHEMAPULSE_SHADOW_DATABASE_URL=postgresql://postgres:postgres@localhost:5433/schemapulse

# ---- Measurement ------------------------------------------------------------ #
# SCHEMAPULSE_QUERY_TIMEOUT_MS=30000
# SCHEMAPULSE_BENCHMARK_RUNS=5
# SCHEMAPULSE_BENCHMARK_WARMUPS=3
# SCHEMAPULSE_MIN_SPEEDUP=1.20
# SCHEMAPULSE_MAX_CANDIDATE_ATTEMPTS=3
# SCHEMAPULSE_ENABLE_REFINEMENT=true

# ---- Demo data -------------------------------------------------------------- #
# SCHEMAPULSE_DEMO_ORDERS=1000000
# SCHEMAPULSE_DEMO_CUSTOMERS=20000

# ---- Output ----------------------------------------------------------------- #
# SCHEMAPULSE_ARTIFACTS_DIR=.schemapulse
# SCHEMAPULSE_VERBOSE=false